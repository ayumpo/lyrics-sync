# Copy to .env and adjust.

# Your music library on the host (read/write: .lrc files are written next to the audio files)
MUSIC_PATH=/path/to/music

# Where the state DB, log, misses.csv and backups go
CONFIG_PATH=./config

# Owner of new .lrc files. Use the same IDs as your media server / music folder (`id youruser`)
PUID=1000
PGID=1000

TZ=UTC
INTERVAL_HOURS=24
